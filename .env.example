# --- Datenbank ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=twitch_panel
DB_CONNECTION_LIMIT=10

# --- Sicherheit ---
# 32 Byte, base64-kodiert. Erzeugen mit: npm run genkeys
# Verschluesselt die TOTP-Secrets in der Datenbank. NIEMALS aendern, sonst sind alle 2FA-Secrets unlesbar.
ENCRYPTION_KEY=

# --- Sessions ---
# Lebensdauer einer Session in Sekunden (Standard: 12 Stunden)
SESSION_TTL_SECONDS=43200
# Session wird verlaengert, wenn weniger als dieser Wert uebrig ist (Standard: 1 Stunde)
SESSION_REFRESH_THRESHOLD_SECONDS=3600

# --- 2FA ---
# true = jeder Account muss 2FA einrichten, bevor er das Panel nutzen kann
ENFORCE_2FA=true
TOTP_ISSUER=TwitchPanel

# --- Twitch-API ---
# Anwendung anlegen unter https://dev.twitch.tv/console/apps
# Ohne diese Werte zeigt das Panel Initialen statt Profilbildern
# und die Twitch-Verknuepfung steht nicht zur Verfuegung.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Oeffentliche Basis-URL des Panels (ohne trailing slash).
# Produktion z. B. https://twitchpanel.example.com – NICHT localhost,
# sonst landen OAuth-Redirects hinter dem Reverse-Proxy auf der internen Adresse.
APP_URL=http://localhost:3000

# Alternativ die Redirect-URI direkt setzen. Sie muss ZEICHENGENAU mit dem
# Eintrag "OAuth Redirect URL" in der Twitch-Anwendung uebereinstimmen.
# Produktion: https://twitchpanel.example.com/auth/twitch/callback
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# true = jeder Account muss beim ersten Login seinen Twitch-Account verknuepfen
ENFORCE_TWITCH_LINK=true

# --- Anmeldeseite ---
# Zeigt auf der Anmeldeseite aggregierte Kennzahlen (Channels, Nachrichten,
# Zuschauer) und ob die Erfassung laeuft. Diese Werte sind OHNE Anmeldung
# sichtbar - Namen oder Inhalte werden nicht angezeigt.
SHOW_PUBLIC_STATUS=true

# --- Wortfilter-Benachrichtigungen ---
# Optional: Discord-Webhook-URL. Wenn gesetzt, wird bei jeder Nachricht, die
# einen aktiven Begriff mit Stufe "kritisch" trifft, automatisch eine
# Benachrichtigung geschickt - unabhängig davon, ob das Panel gerade offen ist.
WATCHLIST_WEBHOOK_URL=

# --- Bot-Status (Dashboard) ---
# Optional: Heartbeat-JSON einer Uptime-Kuma-Statusseite, z. B.
# https://status.example.com/api/status-page/heartbeat/<slug>
# Ohne diesen Wert wird der Status aus der letzten empfangenen Chatnachricht abgeleitet.
KUMA_STATUS_URL=
# Optional: waehlt den Monitor, falls die Statusseite mehrere enthaelt.
KUMA_MONITOR_ID=

# --- Login-Schutz ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Seed (nur fuer den ersten Superadmin) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
